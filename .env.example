NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public widget site key only. Configure its SECRET key in Supabase Auth CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFOS_e-_Oy73qBmS

# Server-only SMS hook secrets. NEVER add NEXT_PUBLIC_ to these names.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
SUPABASE_SEND_SMS_HOOK_SECRET=
SUPABASE_SECRET_KEY=
# Maximum SMS attempts across the whole project in a rolling 24-hour window.
SMS_DAILY_LIMIT=100
PAYSTACK_SECRET_KEY=

# Arkesel USSD. Register /api/ussd/arkesel as the session callback in Arkesel.
ARKESEL_USSD_API_KEY=
ARKESEL_USSD_SERVICE_CODE=
ARKESEL_USSD_SHARED_SECRET=
# Arkesel payment/mobile-money endpoint supplied with your USSD product.
ARKESEL_USSD_PAYMENT_URL=

# Server-only bearer secret for payment reconciliation (at least 32 random characters).
CRON_SECRET=
